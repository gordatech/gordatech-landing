# URL API admin panel Laravel (tanpa garis miring di akhir)
GORDATECH_API_URL=http://localhost:8000/api/v1
# API key dari Admin → API keys (atau: php artisan gordatech:api-key "Vercel Production"). RAHASIA: jangan beri awalan NEXT_PUBLIC_
GORDATECH_API_KEY=gt_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sama persis dengan FRONTEND_REVALIDATE_SECRET di .env Laravel
REVALIDATE_SECRET=ganti-dengan-string-acak-panjang
# Domain publik situs ini (dipakai canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
